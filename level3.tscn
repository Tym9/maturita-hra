[node name="NPCs" type="Node2D" parent="."]

[node name="Vesper" parent="NPCs" instance=ExtResource("18")]
position = Vector2(100, 152)
dialogue_pages = [
"Konečně jsi tady! Přímo před námi je Kotevní hala. Propast je široká šestnáct dlaždic, ale na dně je bezpečná podlaha a po schodech se dostaneš zpátky nahoru.",
"Běžný skok ani dash tě na druhou stranu nepřenesou. V truhle vedle mě máš můj Přitahovací hák (Grapple Hook). Vlož si ho do batohu!",
"Miř pravým tlačítkem [RMB] na zlaté kotvy nad propastí. Hák tě k nim přitáhne a za letu můžeš skočit (katapultový odskok) nebo ho vystřelit znovu na další kotvu."
]

[node name="EventTrigger_ReactorCore" parent="NPCs" instance=ExtResource("19")]
position = Vector2(150, 125)
speaker_name = "Varování systému"
dialogue_pages = [
"POZOR: Chladicí okruh reaktoru je přetížen. Použij přitahovací hák od Vesper na zlaté kotvy a kombinuj katapultový odskok s Gravity Coil Dashem."
]

