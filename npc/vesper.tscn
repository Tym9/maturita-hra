dialogue_pages = [
"Konečně jsi tady! Přímo před námi je Velká propast těžebního komplexu. Padá stovky metrů hluboko a podlaha je plná smrtících bodáků.",
"Běžný skok ani dash tě nepřenesou. V truhle vedle mě máš můj Přitahovací hák (Grapple Hook). Vlož si ho do batohu!",
"Miř pravým tlačítkem [RMB] na zlaté kotvy a stěny nad propastí. Přitáhne tě bleskovou rychlostí a můžeš kombinovat hák, dash i hasák!"
]
