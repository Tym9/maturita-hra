dialogue_pages = [
"Píp... Vítej v šachtě, kamaráde. Dál jsou hluboké propasti a parní trysky, které běžným skokem nepřeletíš.",
"V téhle truhle vedle mě máš Gravitační cívku (Gravity Coil). Otevři truhlu [E] a vlož si ji do batohu [I]!",
"Když ji máš u sebe, stiskem [Mezerníku] provedeš bleskový Dash. Prorazí vzduch, překoná drolící se lávky a zraní každého, kdo ti stojí v cestě!"
]
