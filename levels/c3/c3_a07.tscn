[node name="Vesper" parent="." unique_id=2064830335 instance=ExtResource("5_h11t5")]
position = Vector2(136, 152)
dialogue_pages = Array[String](["Pst! Sem, než tě chytí reflektor. Ty jsi ten kluk z odboje? Mira hlásila, že přijdeš.", "Jsem Vesper. Dřív jsem korporaci stavěla lisy, teď je rozebírám. Krystaly ze Smallville jedou po pásech do rafinerií a odtud nahoru do citadely.", "Na vrcholu hory je ústí velké šachty — vede až k jádru. Lez přes továrny a Horní město, Otis tě čeká ve starých dílnách u šachty. Já tě najdu dole u reaktoru."])
repeat_dialogue_pages = Array[String](["Lisy bijí v rytmu. Počkej, až se zvednou, a pak běž."])

