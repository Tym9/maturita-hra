[node name="Hron" parent="." unique_id=149752246 instance=ExtResource("7_qffn1")]
position = Vector2(152, 152)
dialogue_pages = Array[String](["Nový? Neboj, křičet nebudu. Dvanáct hodin u lisu a za to talíř polévky.", "Ty krystaly, co tu lisujeme, v noci svítí. A lidi z rafinerie kašlou fialově.", "Jestli jdeš proti nim, jdi přes rafinerii a výtahovou šachtou nahoru na střechy."])
