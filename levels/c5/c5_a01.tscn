[node name="Otis" parent="." unique_id=98908685 instance=ExtResource("6_f5nlp")]
position = Vector2(120, 88)
dialogue_pages = Array[String](["Matěji! Ty jsi vážně prošel hlavní branou? Vítej ve starých dílnách. Korporace je zazdila, když prorazila velkou šachtu.", "Pod námi je slévárna. Tam taví krystaly ze Smallville na cívky pro reaktor. Jednu jsem jim ukradl z vagonu.", "Gravitační cívka. Stiskni [Mezerník] se směrem a vyrazíš kamkoli, i ve vzduchu. Nabije se, až se dotkneš země.", "Vezmi si ji z truhly. A pak dolů, šachta vede až k jádru."])
repeat_dialogue_pages = Array[String](["Dash: [Mezerník] + směr. Ve vzduchu jednou, na zemi se cívka nabije."])

[node name="Chest" parent="." unique_id=1135825504 instance=ExtResource("7_61mjg")]
