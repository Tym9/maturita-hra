[node name="Mira" parent="." unique_id=1247227528 instance=ExtResource("6_d7whu")]
position = Vector2(360, 120)
dialogue_pages = Array[String](["Tak ty jsi ten z povrchu. Rozhlédni se — vrty korporace vysávají gravitační krystaly z jádra planety a země praská.", "Smallville, vesnice na svahu nad námi, umírá jako první. Studny jsou otrávené a korporátní stráže vyhánějí poslední rodiny.", "Nad vesnicí, výš na hoře, leží Parní město, sídlo korporace. Odtud vrtají do nitra hory až k jádru planety. Tam musíme udeřit.", "Brann ti v ošetřovně doplní síly. Pak se hlas na hlídkové věži."])
repeat_dialogue_pages = Array[String](["Hlídková věž je na konci tábora. Dej vědět, co vidíš."])

