dialogue_pages = Array[String](["Matěji! Takže jsi prošel povrchem. Vítej na Základně — poslední místo, kam korporace ještě nedosáhla.", "Ten hasák z kůlny sis vzal dobře. Seknutím [LMB / F] rozbiješ hodinový strojek každé stráže.", "Velitelka Mira tě čeká na náměstí za branou."])
