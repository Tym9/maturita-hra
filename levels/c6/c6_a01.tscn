[node name="Rusty" parent="." unique_id=624408572 instance=ExtResource("7_kssrb")]
position = Vector2(88, 88)
dialogue_pages = Array[String](["Tak ty jsi ten, co prošel slévárnou. Vesper hlásila, že přijdeš. Vítej v dolech, Matěji.", "Tyhle štoly kopali naši dědové, než přišla Korporace. Teď tu roste krystal přímo ze skály. A skála kvůli němu praská.", "Tady máš hornický hák. Miř myší a pravým tlačítkem ho vystřel na mosazný kruh. Přitáhne tě a vrátí ti cívku i druhý skok.", "Vezmi si ho z truhly a dej ho do slotu místo hasáku. V rukou uneseš naráz jen dva nástroje, vyměníš je kdykoli v batohu klávesou Tab. Cívku si nech.", "Kruhy jsme natloukli všude, kam se dalo."])
repeat_dialogue_pages = Array[String](["Hák: pravé tlačítko myši na mosazný kruh. Skokem se z něj odrazíš dřív."])

