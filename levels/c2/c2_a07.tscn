[node name="Tobi" parent="." unique_id=1934970390 instance=ExtResource("6_k4eie")]
position = Vector2(136, 152)
dialogue_pages = Array[String](["Ty nejsi od korporace? Uf... Táta říkal, ať nikomu neotvírám.", "Ulice jsou zavalené krystaly a hlídají je stráže. Nahoru se dostaneš jen po střechách!", "Babička Elda je úplně nahoře ve zvonici. Ta ví, kudy dál na horu."])
