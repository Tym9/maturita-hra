[node name="Elda" parent="." unique_id=1977536113 instance=ExtResource("7_wph7a")]
position = Vector2(248, 152)
dialogue_pages = Array[String](["Odboj tě posílá? Pak neseš špatné zprávy pozdě. Korporace dnes ráno spustila vrt přímo pod vesnicí.", "Do Parního města vede jen stará horská stezka nad zvonicí. Jestli se svah utrhne, zůstanou jen útesy.", "Lez, chlapče. My ostatní... my to tu nějak vydržíme."])
