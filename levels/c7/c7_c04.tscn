[node name="Vesper" parent="." unique_id=467395182 instance=ExtResource("7_k8dla")]
position = Vector2(72, 136)
dialogue_pages = Array[String](["Matěji! Tak jsi to dokázal až sem. Jsem tu tři dny jako technik údržby.", "Reaktor je přímo pod námi. Jádro už se neudrží, anomálie se šíří celým komplexem.", "Dál tě bude pronásledovat tvoje vlastní ozvěna. Stín z anomálie, opakuje každý tvůj krok. Nezastavuj se a nevracej se.", "Dole u reaktoru hlídá Strážce. Sabotážní ventil je za ním. Hodně štěstí."])
repeat_dialogue_pages = Array[String](["Ozvěna jde po tvých stopách. Nezastavuj se."])

